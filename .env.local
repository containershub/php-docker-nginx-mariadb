# Map Nginx to an unprivileged development port
# This port is used for running Docker as non-root user. If Docker doesn't have
# root access then it'll not have permissions to use privileged ports like
# ports below 1024. If you run Docker as root then you wouldn't need this!
HOST_HTTP_PORT=8000

MYSQL_PORT=3306
MYSQL_DATABASE=php_docker
MYSQL_USER=<YOUR_MYSQL_USER>
MYSQL_PASSWORD=<YOUR_MYSQL_PASSWORD>
MYSQL_ROOT_PASSWORD=<YOUR_MYSQL_ROOT_PASSWORD>

# Control Xdebug behavior here:
XDEBUG_MODE=off
